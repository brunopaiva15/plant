# Options de curl pour `pod install`, lues via CURL_HOME (voir ios/Podfile).
#
# TensorFlowLiteC, tiré par tflite_flutter, est une archive d'environ 70 Mo
# téléchargée hors du CDN de CocoaPods. Sur Codemagic, le transfert s'est
# figé à 544 ko pendant 4 minutes, puis curl a abandonné sur
# « HTTP/2 stream 1 was not closed cleanly: INTERNAL_ERROR (err 2) » : le
# build a échoué sans rien avoir à compiler.
#
# CocoaPods appelle déjà curl avec `--retry 2`, mais cette option ne relance
# ni une erreur HTTP/2 (92) ni un transfert figé. D'où :

# HTTP/1.1 : l'erreur venait de la couche HTTP/2.
http1.1
# Les deux relances de CocoaPods valent pour toute erreur, 92 comprise.
retry-all-errors
retry-delay = 5
# Moins de 10 ko/s pendant 60 s : le transfert est figé, curl l'arrête et
# le relance au lieu d'attendre.
speed-limit = 10240
speed-time = 60
