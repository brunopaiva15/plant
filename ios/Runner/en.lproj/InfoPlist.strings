/* Permission prompts, in English. See fr.lproj/InfoPlist.strings. */

"NSLocationWhenInUseUsageDescription" = "Auxine uses your location once to find the city for your weather. The app does not keep or share it.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Auxine uses your location once, while the app is open, to find the city for your weather. The app does not track it in the background, keep it or share it.";
