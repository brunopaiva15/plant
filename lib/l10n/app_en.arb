  "pgVineName": "Stem cutting",
  "pgVineHint": "A node, a clean cut, water",
  "pgVineNodeTitle": "The node",
  "pgVineNodeBody": "Find the swelling where a leaf starts, often with an aerial root beside it. Keep at least one on the cutting.",
  "pgVineNodeNote": "Node and aerial root",
  "pgVineCutTitle": "The cut",
  "pgVineCutBody": "With a clean blade, cut cleanly 1 cm below the node: the node stays on the cutting.",
  "pgVineCutNote": "Cutting above the node",
  "pgVineClearTitle": "The bare node",
  "pgVineClearBody": "Remove the leaves that would sit under water. Keep 2 or 3 on top: they feed the cutting.",
  "pgVineWaterTitle": "The water",
  "pgVineWaterBody": "Put the node under the water, the leaves above it. Set the glass in bright light, out of direct sun.",
  "pgVineRootsTitle": "The roots",
  "pgVineRootsBody": "The roots come out of the node, not the bottom of the stem. Change the water every week.",
  "pgVineRootsNote": "First roots in 2 to 6 weeks",
  "pgVinePotTitle": "The pot",
  "pgVinePotBody": "When the roots are a few centimetres long, pot the cutting in light potting mix, the node just under the surface.",
  "pgSoftName": "Soft stem cutting",
  "pgSoftHint": "A young shoot, fast roots",
  "pgSoftStemTitle": "The shoot",
  "pgSoftStemBody": "Pick a young, firm shoot without flowers, about 10 cm: old wood roots badly.",
  "pgSoftCutTitle": "The cut",
  "pgSoftCutBody": "With a clean blade, cut just below a pair of leaves: the roots will start there.",
  "pgSoftStripTitle": "The lower leaves",
  "pgSoftStripBody": "Remove the lowest pair to bare 3 to 4 cm of stem.",
  "pgSoftStripNote": "Leaving a leaf under water",
  "pgSoftRootTitle": "Rooting",
  "pgSoftRootBody": "Stand the bare stem in the water and keep the leaves dry, in bright light and out of direct sun.",
  "pgSoftRootsTitle": "The roots",
  "pgSoftRootsBody": "The roots are fine and many, and come from the whole submerged part.",
  "pgSoftRootsNote": "First roots in 1 to 3 weeks",
  "pgSoftPotTitle": "Potting on",
  "pgSoftPotBody": "Pot it early, at 2 to 3 cm of root: a soft stem does not keep well.",
  "pgLeafName": "Leaf cutting",
  "pgLeafHint": "Slower, one leaf is enough",
  "pgLeafChooseTitle": "The leaf",
  "pgLeafChooseBody": "Pick a mature, firm leaf with no marks: young leaves have no reserves.",
  "pgLeafCutTitle": "The cut",
  "pgLeafCutBody": "With a clean blade, cut the leaf at its base, level with the substrate.",
  "pgLeafSplitTitle": "The segments",
  "pgLeafSplitBody": "Cut the leaf into pieces of 5 to 8 cm. Cut a V at the bottom of each to mark the end that goes down.",
  "pgLeafSplitNote": "The V marks the bottom",
  "pgLeafCallusTitle": "Drying",
  "pgLeafCallusBody": "Let the cuts dry in the air, in the shade, before planting them.",
  "pgLeafCallusNote": "1 to 2 days of drying",
  "pgLeafPlantTitle": "The substrate",
  "pgLeafPlantBody": "Push the V 2 cm into a free-draining substrate.",
  "pgLeafPlantNote": "Planting a segment upside down",
  "pgLeafGrowthTitle": "New growth",
  "pgLeafGrowthBody": "The roots come first; the young shoot rises from the substrate beside the segment.",
  "pgLeafGrowthNote": "New shoot in 2 to 4 months",
  "pgDivisionName": "Division",
  "pgDivisionHint": "Quick and reliable, for clump-forming plants",
  "pgDivPlantTitle": "The clump",
  "pgDivPlantBody": "Take the plant out of the pot whole. A substrate watered the day before holds together better.",
  "pgDivUnpotTitle": "Out of the pot",
  "pgDivUnpotBody": "Slide the pot off the root ball to free the plant.",
  "pgDivRootsTitle": "The root ball",
  "pgDivRootsBody": "Crumble the soil away until you can see the roots and the base of the shoots.",
  "pgDivClustersTitle": "The two groups",
  "pgDivClustersBody": "Each group keeps its own shoots and its own roots.",
  "pgDivClustersNote": "Leaves and roots on each side",
  "pgDivSplitTitle": "The split",
  "pgDivSplitBody": "Pull the groups apart by hand. Use the blade only if the crowns hold.",
  "pgDivSplitNote": "Cutting a stem above the soil",
  "pgDivRepotTitle": "Repotting",
  "pgDivRepotBody": "Pot each division in its own pot, at the depth it had before, then water it once.",
  "pgOffsetName": "Offset",
  "pgOffsetHint": "The offset leaves with its own roots",
  "pgOffSpotTitle": "The offset",
  "pgOffSpotBody": "An offset a third the size of the mother plant, with leaves of its own, is ready to leave.",
  "pgOffSpotNote": "An offset already formed",
  "pgOffClearTitle": "Clearing",
  "pgOffClearBody": "Clear the substrate around the base until the link to the mother plant shows.",
  "pgOffDetachTitle": "The split",
  "pgOffDetachBody": "Pull the offset away with its roots. Use the blade only if the link is woody.",
  "pgOffDetachNote": "Pulling the offset off without roots",
  "pgOffRootsTitle": "The roots",
  "pgOffRootsBody": "A few clean roots are enough. Without them the offset dries before it takes.",
  "pgOffPotTitle": "The pot",
  "pgOffPotBody": "Pot it in a small pot with the substrate the species wants, then water lightly.",
  "pgOffSettleTitle": "Settling in",
  "pgOffSettleBody": "A new leaf at the centre means the offset has taken.",
  "pgOffSettleNote": "Takes in 3 to 6 weeks",
  "pgKeikiName": "Separate a keiki",
  "pgKeikiHint": "The orchid's offshoot leaves with its roots",
  "pgKeikiSpotTitle": "The keiki",
  "pgKeikiSpotBody": "A young plant grows on a node of the flower spike: 2 leaves and aerial roots make it recognisable.",
  "pgKeikiSpotNote": "An offshoot already formed",
  "pgKeikiWaitTitle": "The roots",
  "pgKeikiWaitBody": "The roots lengthen along the spike. At 3 to 5 roots a few centimetres long, the keiki can live on its own.",
  "pgKeikiWaitNote": "Roots ready in 2 to 3 months",
  "pgKeikiDetachTitle": "The split",
  "pgKeikiDetachBody": "Cut the spike on either side of the keiki, 1 or 2 cm away. Do not pull: you would bruise the base.",
  "pgKeikiDetachNote": "Pulling the keiki off",
  "pgKeikiRootsTitle": "The keiki's roots",
  "pgKeikiRootsBody": "Keep the keiki's aerial roots: they are the ones that take in the pot.",
  "pgKeikiPotTitle": "The pot",
  "pgKeikiPotBody": "Pot it in a small pot of bark, the base of the keiki level with the substrate, not buried.",
  "pgKeikiSettleTitle": "Settling in",
  "pgKeikiSettleBody": "A new leaf at the centre means the keiki has taken.",
  "pgKeikiSettleNote": "Takes in 1 to 2 months",
  "pgSegmentName": "Segment cutting",
  "pgSegmentHint": "A segment detached, dried, planted",
  "pgSegChooseTitle": "The segment",
  "pgSegChooseBody": "Pick a firm terminal segment with no wrinkles, 2 or 3 joints long.",
  "pgSegDetachTitle": "Detaching",
  "pgSegDetachBody": "Twist the segment off at the joint. Use a clean blade if it holds.",
  "pgSegDetachNote": "Pulling and tearing the joint",
  "pgSegWoundTitle": "The wound",
  "pgSegWoundBody": "The cut is pale and damp: planted straight away, it would rot.",
  "pgSegCallusTitle": "The callus",
  "pgSegCallusBody": "Let the wound dry in the air, in the shade, until it forms a matt callus.",
  "pgSegCallusNote": "3 to 7 days of drying",
  "pgSegPlantTitle": "The substrate",
  "pgSegPlantBody": "Set the callused end barely 1 cm into a very free-draining substrate.",
  "pgSegPlantNote": "Burying the segment",
  "pgSegRootsTitle": "New growth",
  "pgSegRootsBody": "The roots come first, then a new joint. Wait until the roots hold before watering.",
