# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Reconnaissance de plantes : jeux d'images, modèles, caches — jamais dans Git
/dataset/
/tools/plant_dataset/dataset/
/tools/plant_dataset/dataset_*/
/tools/plant_dataset/shard*/
/tools/plant_dataset/.cache/
/tools/plant_model/.cache/
/tools/rhs_care/cache/
/tools/plant_dataset/.pytest_cache/
/models/
/checkpoints/
*.tflite
# …sauf le modèle livré dans l'application : c'est un asset, pas un artefact.
!/assets/model/*.tflite
*.mlmodel
*.mlpackage
*.onnx
*.pt
*.pth
*.h5
*.safetensors
__pycache__/

# Le SDK des Home APIs de Google, décompressé dans `vendor/GoogleHomeSDK`
# pour qu'Xcode le référence par un chemin relatif portable. À la racine et
# non sous `ios/` : Xcode refuse un paquet local placé sous le dossier qui
# contient le `.xcodeproj`, où vit déjà le paquet généré de Flutter. Six
# cents mégaoctets de binaires signés qui n'ont rien à faire dans un dépôt,
# et que Google veut qu'on télécharge soi-même depuis sa console. Voir
# docs/05-technical-architecture.md, section « Google Home ».
/vendor/

# Caches locaux des outils (wrangler, supabase cli)
share-proxy/.wrangler/
supabase/.temp/
